@@ -15,8 +15,15 @@
                                     * timing writes to it did not stop the tearing on hardware. */
 #endif
 
+#ifndef LCD_BAUD_REC
+#define LCD_BAUD_REC LCD_BAUD      /* (MIFM1) while a host records the USB audio input (main_fm1.c sets lcd_baud_want):
+                                    * an app's own. MIFM1's recordings, at 60 MHz, had a few samples gone to zero in a
+                                    * packet each time the screen sent pixels (none lost, the headphones clean) */
+#endif
+
 static uint8_t lcd_small[64];
 static uint8_t lcd_busy;           /* a lcd_data DMA may still run; CS is low */
+static uint8_t lcd_baud_now = LCD_BAUD, lcd_baud_want = LCD_BAUD;   /* (MIFM1) changed between transfers only */
 #if FM1B_MIRROR
 /* screen mirroring over USB (mirror.c): every blit and fill copied while a host watches */
 static uint8_t mirror_on;
@@ -52,6 +59,8 @@ static void lcd_data(const void *p, uint32_t n)
     if (!n)
         return;                    /* SPI_CNT = 0 never completes */
     lcd_sync();
+    if (lcd_baud_now != lcd_baud_want)
+        fm1_lcd_baud(lcd_baud_now = lcd_baud_want);
     fm1_lcd_send_data(p, n);
     lcd_busy = 1;                  /* completed by lcd_sync */
 }
