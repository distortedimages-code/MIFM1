--- a/device/plat_fm1.c
+++ b/device/plat_fm1.c
@@ -200,6 +200,19 @@ void plat_host_patience(uint32_t try_ms, uint32_t total_ms)
 /* USB audio full: the render at full level for the USB audio input, MASTER after it (main_fm1.c render_block) */
 static volatile uint8_t uac_full;
 void plat_usb_audio_full(int on) { uac_full = (uint8_t)(on != 0); }
+void plat_usb_audio_info(uint32_t *v)          /* (MIFM1) the stream's rate, and its glitches since it started */
+{
+#if FELUCCA_UAC
+    static uint32_t starts, base;
+    uint32_t lost = uac.underruns + uac.overruns + uac.missed + uac.stalls;
+    if (uac.starts != starts)
+        starts = uac.starts, base = lost;
+    v[0] = uac.alt && usb.config && uac.flowing ? (uac.r48 ? 48000u : 44100u) : 0u;
+    v[1] = lost - base;
+#else
+    v[0] = v[1] = 0;
+#endif
+}
 /* the computer's USB audio's level in the mix, 0..4096 (uac_mix.h; read by the render: one word, no lock) */
 static volatile uint32_t usb_play_q12 = 4096u;
 void plat_usb_play_gain(uint32_t q12) { usb_play_q12 = q12 > 4096u ? 4096u : q12; }
