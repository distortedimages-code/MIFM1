 BOOT_PACKED = None                                # (raw, packed) bytes of the boot-packed load images, or None
 
 
+def elf_rename(path, names):
+    """(MIFM1) an ELF32 object's sections renamed (old name: new name): the new names in a string table of their
+    own at the file's end, its header moved there (the old table kept where it is, unused)"""
+    b = bytearray(Path(path).read_bytes())
+    if b[:4] != b"\x7fELF" or b[4] != 1:
+        raise SystemExit(f"build: {path}: not an ELF32 object")
+    e = "<" if b[5] == 1 else ">"
+    shoff, = struct.unpack_from(e + "I", b, 0x20)
+    shentsize, shnum, shstrndx = struct.unpack_from(e + "HHH", b, 0x2E)
+    sh = lambda i: shoff + i * shentsize
+    str_off, str_size = struct.unpack_from(e + "II", b, sh(shstrndx) + 16)
+    old = bytes(b[str_off:str_off + str_size])
+    table, done = bytearray(old), 0
+    for i in range(shnum):
+        n, = struct.unpack_from(e + "I", b, sh(i))
+        name = old[n:old.index(b"\0", n)].decode()
+        if name in names:
+            struct.pack_into(e + "I", b, sh(i), len(table))
+            table += names[name].encode() + b"\0"
+            done += 1
+    if done:
+        b += b"\0" * (-len(b) % 4)
+        struct.pack_into(e + "II", b, sh(shstrndx) + 16, len(b), len(table))
+        b += table
+        Path(path).write_bytes(bytes(b))
+    return done
+
