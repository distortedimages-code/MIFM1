     jieli = (BLE and not OWN) or WIFI             # JieLi's libraries linked (the shim, LTO)
@@ -705,6 +735,13 @@ def build_app():
         tc_all(("cc", *opt, "-c", OUT / "unity.pass.ll", "-o", OUT / "unity.o"),
                *[("cc", *[f if f not in ("-Os", "-Oz") else "-O2" for f in opt], "-c", o.with_suffix(".pass.ll"), "-o", o)
                  for _, o in o2_units])
+    ram = {}                                      # (MIFM1) o2_ram = ["unit:function", ...]: functions moved to the RAM
+    for e in CONF.get("o2_ram", []):              # code as compiled (their inlining as in the flash), their sections
