"""emcc for fm1-base's tools/build.py --web, without Emscripten: the same commands given to Zig's clang (pip install
ziglang), wasm32-wasi with its libc (wasi-libc). The page's worklet (base/web/emu/worklet.js) gives a standalone wasm
the WASI imports it asks for, so the result runs there as Emscripten's -sSTANDALONE_WASM would.

  make web   (from the repository: base/tools/build.py ../firmware --web, this directory first in PATH)

What it translates: -sSTACK_SIZE (the linker's stack), -sINITIAL_MEMORY, -sALLOW_MEMORY_GROWTH=0 (the memory's maximum
its initial size: an .rfm1's fixed memory, build.py --rfm1; and malloc on the memory after the data and the stack,
tools/web/heap.c, as Emscripten's: wasi-libc's grows the memory for its every byte), --no-entry (a reactor:
_initialize), and the exports: every function its sources mark __attribute__((used, visibility("default")))
(EMSCRIPTEN_KEEPALIVE's spelling; export_name(...) exports itself). Other -s settings have no meaning here and are
dropped."""
import os, re, subprocess, sys

args = sys.argv[1:]
if args and args[0] == "--version":
    print("emcc (zig cc shim, tools/web/emcc) " + subprocess.run([sys.executable, "-m", "ziglang", "version"],
                                                                   capture_output=True, text=True).stdout.strip())
    sys.exit(0)
out, link, cxx, srcs, rest, ldflags = None, "-c" not in args, False, [], [], []
initial, fixed = None, False
i = 0
while i < len(args):
    a = args[i]
    if a == "-o":
        out = args[i + 1]
        rest += [a, out]
        i += 2
        continue
    if a.startswith("-s"):
        k, _, v = a[2:].partition("=")
        if k == "STACK_SIZE":
            ldflags.append(f"-Wl,-z,stack-size={v}")
        elif k == "INITIAL_MEMORY":
            ldflags.append(f"-Wl,--initial-memory={v}")
            initial = v
        elif k == "ALLOW_MEMORY_GROWTH":
            fixed = v == "0"
    elif a == "--no-entry":
        ldflags.append("-mexec-model=reactor")
    else:
        if a.endswith((".cc", ".cpp")):
            cxx = True
        if a.endswith((".c", ".cc", ".cpp")):
            srcs.append(a)
        rest.append(a)
    i += 1
# (build.py adds each unit's own directory with -I: searched last here, after the C library, or Plaits'
# physical_modelling/string.h would stand for <string.h>)
if not link:
    here = {os.path.abspath(os.path.dirname(s)) for s in srcs}
    rest = [x for a in rest for x in ((["-idirafter", a[2:]]) if a.startswith("-I") and os.path.abspath(a[2:]) in here
                                       else [a])]
cmd = [sys.executable, "-m", "ziglang", "c++" if cxx or link else "cc", "-target", "wasm32-wasi",
       "-fno-stack-protector", "-D_WASI_EMULATED_SIGNAL", "-D__EMSCRIPTEN__"]
if link:
    exports = set()
    for s in srcs:
        text = open(s, errors="replace").read()
        exports |= set(re.findall(r'visibility\("default"\)\)\)\s*[\w\s\*]+?\b(\w+)\s*\(', text))
        for inc in re.findall(r'#include\s+"(\w+\.c)"', text):   # (web.c, the app's own exports)
            for d in [os.path.dirname(s)] + [a[2:] for a in args if a.startswith("-I")]:
                p = os.path.join(d, inc)
                if os.path.exists(p):
                    exports |= set(re.findall(r'visibility\("default"\)\)\)\s*[\w\s\*]+?\b(\w+)\s*\(',
                                              open(p, errors="replace").read()))
                    break
    ldflags += [f"-Wl,--export={e}" for e in sorted(exports)]
    ldflags += ["-lwasi-emulated-signal", "-Wl,--strip-debug"]
    if fixed and initial:
        ldflags.append(f"-Wl,--max-memory={initial}")
        rest.append(os.path.join(os.path.dirname(os.path.abspath(__file__)), "heap.c"))
r = subprocess.run(cmd + rest + (ldflags if link else []))
sys.exit(r.returncode)
